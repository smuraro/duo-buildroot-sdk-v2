# -*- coding: utf-8 -*-
import time
from pinpong.board import gboard, I2C

class LIS2DH:
    LIS2DH12_RANGE_2GA      = 0x00
    LIS2DH12_RANGE_4GA      = 0x10
    LIS2DH12_RANGE_8GA      = 0x20
    LIS2DH12_RANGE_16GA     = 0x30

    def __init__(self, board=None, i2c_addr=0x1d, bus_num=4):
        if isinstance(board, int):
            i2c_addr = board
            board = gboard
        elif board is None:
            board = gboard
        
        self.board = board
        self.i2c_addr = i2c_addr
        self.i2c = I2C(bus_num)
        self.x = 0
        self.y = 0
        self.z = 0

    def init(self, range_val):
        self.set_range(range_val)
    
    # Liga o sensor (100Hz, eixos XYZ)
        self.write_reg(0x20, 0x2F) 
    
    # Define a escala (range)
        self.write_reg(0x23, range_val)
    
        time.sleep(0.1)
        return True

    def read_XYZ(self):
        # 0xA8 habilita auto-incremento para ler 6 bytes (X_L ate Z_H)
        data = self.read_reg(0xA8, 6)
        
        if not data or len(data) < 6:
            return

        # Converte bytes para inteiros de 16 bits (Complemento de 2)
        def to_int16(low, high):
            val = (high << 8) | low
            if val > 32767: val -= 65536
            return val

        raw_x = to_int16(data[0], data[1])
        raw_y = to_int16(data[2], data[3])
        raw_z = to_int16(data[4], data[5])

        # Formula de conversao mg (mili-g)
        self.x = -(raw_x * 1000 // (1024 * self.scale_vel))
        self.y = -(raw_y * 1000 // (1024 * self.scale_vel))
        self.z = -(raw_z * 1000 // (1024 * self.scale_vel))

    def set_range(self, range_val):
        if range_val == self.LIS2DH12_RANGE_2GA: self.scale_vel = 16
        elif range_val == self.LIS2DH12_RANGE_4GA: self.scale_vel = 8
        elif range_val == self.LIS2DH12_RANGE_8GA: self.scale_vel = 4
        elif range_val == self.LIS2DH12_RANGE_16GA: self.scale_vel = 2
        else: self.scale_vel = 16

    def write_reg(self, reg, data):
    # Se data for um inteiro (ex: 0x2F), transformamos em lista [0x2F]
        if isinstance(data, int):
           data = [data]
    # Agora a PinPong conseguira iterar sobre o dado
        self.i2c.writeto_mem(self.i2c_addr, reg, data)

    def read_reg(self, reg, lens):
        # 0x80 eh o bit de leitura multipla no LIS2DH
        return self.i2c.readfrom_mem(self.i2c_addr, reg, lens)
